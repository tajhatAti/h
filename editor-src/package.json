{
  "name": "codenest-editor",
  "private": true,
  "version": "1.0.0",
  "description": "CodeMirror 6 bundle for CodeNest (built once, output committed to static/)",
  "scripts": {
    "build": "esbuild cm6.js --bundle --format=iife --global-name=CN6 --minify --target=es2018 --outfile=../static/cm6.bundle.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-php": "^6.0.1",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/language": "^6.10.8",
    "@codemirror/legacy-modes": "^6.4.2",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1"
  },
  "devDependencies": { "esbuild": "^0.24.0" }
}
