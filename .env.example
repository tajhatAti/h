# ===========================================
# Ahad Co - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to GitHub!
# ===========================================

# Email Service (Brevo/Sendinblue)
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=Ahad Co

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Leave DATABASE_URL UNSET to use a local SQLite file (great for development —
# zero setup). Set it to a postgresql:// URL to use PostgreSQL (Supabase free
# tier) so your data persists permanently.
#
# Get this from Supabase Dashboard -> Project Settings -> Database ->
# "Connection string" -> "Session pooler" (port 5432) or "Transaction pooler"
# (port 6543). Paste it here, replacing [YOUR-PASSWORD].
#
#   DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
#
# When DATABASE_URL is unset, the app uses the SQLite file at DB_PATH instead:
DB_PATH=/app/data/database.db

# SSL mode for PostgreSQL. Supabase & most managed Postgres require SSL.
# "prefer" (default) uses SSL when available and falls back otherwise.
# Use "require" to force SSL, or "disable" for a local no-SSL dev server.
# PG_SSLMODE=prefer

# OTP Settings
OTP_EXPIRY_MINUTES=10

# ---------------------------------------------------------------------------
# CODE EXECUTION (runner service — SEPARATE Render service)
# ---------------------------------------------------------------------------
# These connect the main website to the separate code-runner service.
# The runner service has its own deploy (runner/ directory).
# Users NEVER see these — they stay server-side only.
#
# RUNNER_SERVICE_URL = the URL of the runner service after deploy.
#   Example: https://ahad-code-runner.onrender.com
# RUNNER_SERVICE_SECRET = a strong random string, SAME on both services.
#   Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# RUNNER_SERVICE_URL=
# RUNNER_SERVICE_SECRET=

# ── CAPACITY ─────────────────────────────────────────────────────────
# Two DIFFERENT limits. Conflating them is what once showed a brand-new
# account "Runner at capacity (5/5)" when the jobs belonged to other people.
#
# MAX_JOBS_PER_USER  fairness — how many bots ONE account may run at once.
#                    Enforced by the main site. Default 3.
# MAX_BG_JOBS        hardware — how many bots ONE runner container can hold.
#                    Set on the RUNNER service. Default 12, which suits a
#                    512MB Render instance. Do not raise it past what the RAM
#                    can actually hold; you will just get OOM kills.
#
# MAX_JOBS_PER_USER=3
# MAX_BG_JOBS=12
#
# ── SCALING OUT: more capacity = more runners ────────────────────────
# Each extra runner service is another 512MB, so the site ceiling becomes
# runners x MAX_BG_JOBS. Deploy runner/ again as a new Render service (same
# RUNNER_SERVICE_SECRET) and add its URL here, comma-separated:
#
# RUNNER_SERVICE_URLS=https://runner-b.onrender.com,https://runner-c.onrender.com
#
# A new job is placed on the first runner with room; when one reports itself
# full the site rolls to the next automatically. Existing jobs always keep
# talking to the runner they were created on.

# Python Version
PYTHON_VERSION=3.11

# ---------------------------------------------------------------------------
# TELEGRAM
# ---------------------------------------------------------------------------
# Token from @BotFather. Powers BOTH the in-process RunSpace bot
# (services/pingbot.py — /ping, /code) AND the HMAC check for the
# "Sign in with Telegram" widget. Leave unset to disable both.
# TELEGRAM_PING_BOT_TOKEN=123456:AA...

# The bot's public @username (with or without the @). REQUIRED for the
# Telegram login widget to render — the frontend reads it from
# /api/public-config. Must be the same bot as the token above, and that
# bot's domain must be set via @BotFather -> /setdomain.
# TELEGRAM_BOT_USERNAME=MyCodeNestBot

# Default target for /ping when no URL is given.
# PING_DEFAULT_TARGET=https://ahadorg.onrender.com
# PING_TIMEOUT_S=8

# ---------------------------------------------------------------------------
# AUTH MODE / ABUSE PREVENTION TOGGLES
# ---------------------------------------------------------------------------
# Telegram-only sign-in (current scope). The email+password+OTP flow is still
# fully implemented server-side; set to 0 to show its UI again.
# TELEGRAM_ONLY_AUTH=1

# Cross-account device-fingerprint / IP cluster job limiting.
# Implemented and tested in services/limits.py but DISABLED by default —
# current scope is a simple per-account cap of 3 concurrent jobs.
# Set to 1 to re-enable cluster limits.
# CLUSTER_LIMITS_ENABLED=0

# Max seconds a single RunSpace log stream (SSE) stays open before the client
# is asked to reconnect. Prevents forgotten tabs pinning server connections.
# SSE_MAX_LIFETIME_S=900
